# AI Gateway Keys (server-side only; never expose to frontend)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# Application URL
APP_URL="MY_APP_URL"

# Backend Security & Runtime (REQUIRED in production)
ENVIRONMENT="production"
DEBUG="False"
SECRET_KEY="MY_SECRET_KEY_MIN_32_CHARS_RANDOM_HEX"
CORS_ORIGINS='["https://your-domain.example"]'

# PostgreSQL + pgvector Connection
POSTGRES_DB="rayhan_workbench"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="MY_POSTGRES_PASSWORD"
DATABASE_URL="postgresql+asyncpg://postgres:MY_POSTGRES_PASSWORD@localhost:5432/rayhan_workbench"

# Rate Limiting
RATE_LIMIT_PER_MINUTE="60"
RATE_LIMIT_AUTH_PER_MINUTE="5"
RATE_LIMIT_PUBLIC_PER_MINUTE="30"
