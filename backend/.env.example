# Database connection (PostgreSQL 15+ with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_pass_123@localhost:5432/rayhan_workbench

# Security & JWT Token Generation (Must be at least 32 characters)
SECRET_KEY=change-this-to-a-secure-random-string-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# AI Gateway Settings (Backend only - Never expose in frontend or git)
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
PRIMARY_PROVIDER=gemini
FALLBACK_PROVIDER=claude
MAX_TOKENS_DEFAULT=1000
COST_ALERT_THRESHOLD_USD=10.0

# Environment Mode
ENVIRONMENT=development
DEBUG=False
